/legado-flutter/app/android/build/

# 本地运行与调试产物（调试数据库、真实书源、APK 分享页、运行日志）
/.legado-dev/
/.apk-share/
/legado-flutter/*.log
/legado-flutter/app_test_out.txt

# 本地 AI/Agent 工具链状态：MCP 配置、skills 缓存（含本机绝对路径，不可跨机器复用）
/legado-flutter/.agents/
/legado-flutter/.mcp.json
/legado-flutter/skills-lock.json

